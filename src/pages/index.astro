---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Havenbath by Msquare Groups | Luxury Bathtubs & Spa Tubs in Madurai">
	<!-- Sticky Header -->
	<nav class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-tertiary-container/30 transition-all duration-300">
		<div class="flex justify-between items-center h-20 px-gutter max-w-container-max mx-auto">
			<a class="font-display-md text-title-lg tracking-widest text-on-background hover:text-primary transition-colors" href="#">
				HAVENBATH
			</a>
			
			<!-- Desktop Menu -->
			<div class="hidden md:flex space-x-8 items-center">
				<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#heritage">Heritage</a>
				<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#collection">Collection</a>
				<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#gallery">Gallery</a>
				<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#location">Location</a>
			</div>
			
			<a class="hidden md:flex items-center text-primary hover:opacity-80 transition-opacity font-label-md text-label-md tracking-wider" href="tel:+919841747859">
				<span class="material-symbols-outlined mr-2" style="font-variation-settings: 'FILL' 1;">call</span>
				+91 98417 47859
			</a>
			
			<!-- Mobile Toggle Button -->
			<button class="md:hidden text-on-surface focus:outline-none" aria-label="Toggle Menu">
				<span class="material-symbols-outlined text-3xl">menu</span>
			</button>
		</div>
	</nav>

	<!-- Mobile Dropdown Navigation -->
	<div id="mobile-menu" class="hidden md:hidden fixed top-20 left-0 w-full bg-surface border-b border-tertiary-container/30 px-gutter py-6 z-40 transition-all duration-300">
		<div class="flex flex-col space-y-4">
			<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#heritage">Heritage</a>
			<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#collection">Collection</a>
			<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#gallery">Gallery</a>
			<a class="text-on-surface-variant hover:text-primary transition-colors duration-300 font-label-md text-label-md uppercase" href="#location">Location</a>
			<a class="flex items-center text-primary hover:opacity-80 transition-opacity font-label-md text-label-md tracking-wider pt-4 border-t border-outline-variant/20" href="tel:+919841747859">
				<span class="material-symbols-outlined mr-2" style="font-variation-settings: 'FILL' 1;">call</span>
				+91 98417 47859
			</a>
		</div>
	</div>

	<main class="pt-20">
		<!-- Hero Section -->
		<section class="relative h-[calc(100vh-80px)] min-h-[600px] flex items-center justify-center w-full overflow-hidden">
			<!-- Local Optimized Hero Image -->
			<div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url('/images/hero-bg.jpg');"></div>
			<!-- Vignette Overlay for Text Legibility -->
			<div class="absolute inset-0 w-full h-full hero-vignette bg-black/40"></div>
			
			<div class="relative z-10 text-center px-6 md:px-12 max-w-4xl mx-auto flex flex-col items-center">
				<h1 class="font-display-lg text-4xl md:text-6xl text-white mb-6 leading-tight">
					Redefine Your Bathing Experience
				</h1>
				<p class="font-body-lg text-lg md:text-xl text-surface-bright mb-12 max-w-2xl font-light">
					Madurai's First Luxury Showroom for Premium Bathtubs, Spa Tubs & Jacuzzi Systems — by Msquare Groups
				</p>
				<div class="flex flex-col sm:flex-row gap-6 items-center">
					<a class="bg-on-background text-white px-8 py-4 font-label-md text-label-md tracking-wider hover:bg-primary transition-colors duration-300 text-center w-full sm:w-auto uppercase" href="#location">
						Visit Our Showroom
					</a>
					<a class="border border-white/40 text-white px-8 py-4 font-label-md text-label-md tracking-wider hover:bg-white/10 transition-colors duration-300 text-center w-full sm:w-auto uppercase" href="tel:+919841747859">
						Call Now — +91 98417 47859
					</a>
				</div>
			</div>
		</section>

		<!-- Brand Introduction (Heritage) -->
		<section class="py-section-gap px-gutter max-w-container-max mx-auto text-center" id="heritage">
			<div class="w-24 h-px divider-gold mx-auto mb-12"></div>
			<h2 class="font-display-md text-3xl md:text-5xl text-on-surface mb-8">Welcome to Havenbath</h2>
			<div class="max-w-3xl mx-auto">
				<p class="font-body-lg text-lg md:text-xl text-on-surface-variant leading-relaxed font-light">
					Step into a sanctuary of tranquility. As Madurai's premier destination for luxury bathing solutions, Havenbath curates an exquisite collection of international designs infused with modern technology. We believe a bath is more than a routine; it is a ritual of rejuvenation. Discover craftsmanship that transforms your space into a private five-star spa.
				</p>
			</div>
			<div class="w-24 h-px divider-gold mx-auto mt-12"></div>
		</section>

		<!-- Product Highlights (Collection) -->
		<section class="py-section-gap px-gutter max-w-container-max mx-auto bg-surface-container-low" id="collection">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Highlight 1 -->
				<div class="flex flex-col items-center text-center p-8 bg-surface transition-transform duration-500 hover:-translate-y-2 border border-transparent hover:border-outline-variant">
					<div class="w-full h-64 mb-8 bg-surface-container-highest flex items-center justify-center p-8">
						<img alt="Luxury Bathtub Icon" class="w-full h-full object-contain opacity-90 mix-blend-multiply" src="/images/bathtub-icon.png"/>
					</div>
					<div class="w-10 h-px divider-gold mb-6"></div>
					<h3 class="font-display-md text-2xl text-on-surface mb-4">Bathtubs</h3>
					<p class="font-body-md text-on-surface-variant">
						Exclusive luxury bathtub collections crafted from premium materials.
					</p>
				</div>
				
				<!-- Highlight 2 -->
				<div class="flex flex-col items-center text-center p-8 bg-surface transition-transform duration-500 hover:-translate-y-2 border border-transparent hover:border-outline-variant">
					<div class="w-full h-64 mb-8 bg-surface-container-highest flex items-center justify-center p-8">
						<img alt="Spa Jacuzzi Icon" class="w-full h-full object-contain opacity-90 mix-blend-multiply" src="/images/spa-icon.png"/>
					</div>
					<div class="w-10 h-px divider-gold mb-6"></div>
					<h3 class="font-display-md text-2xl text-on-surface mb-4">Spa Systems</h3>
					<p class="font-body-md text-on-surface-variant">
						Modern spa and jacuzzi models for ultimate relaxation.
					</p>
				</div>
				
				<!-- Highlight 3 -->
				<div class="flex flex-col items-center text-center p-8 bg-surface transition-transform duration-500 hover:-translate-y-2 border border-transparent hover:border-outline-variant">
					<div class="w-full h-64 mb-8 bg-surface-container-highest flex items-center justify-center p-8">
						<img alt="Premium Fittings Icon" class="w-full h-full object-contain opacity-90 mix-blend-multiply" src="/images/fittings-icon.png"/>
					</div>
					<div class="w-10 h-px divider-gold mb-6"></div>
					<h3 class="font-display-md text-2xl text-on-surface mb-4">Fittings</h3>
					<p class="font-body-md text-on-surface-variant">
						Premium fittings and accessories from top international brands.
					</p>
				</div>
			</div>
		</section>

		<!-- Why Havenbath -->
		<section class="py-24 px-gutter max-w-container-max mx-auto border-t border-b border-outline-variant/30">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center divide-y md:divide-y-0 md:divide-x divide-outline-variant/30">
				<div class="py-6 md:py-0 px-6">
					<span class="material-symbols-outlined text-4xl text-primary mb-4" style="font-variation-settings: 'wght' 200;">public</span>
					<h4 class="font-title-lg text-lg text-on-surface mb-2 uppercase tracking-wider">International Designs</h4>
					<p class="font-body-md text-on-surface-variant font-light">Curated collections from global artisans.</p>
				</div>
				<div class="py-6 md:py-0 px-6">
					<span class="material-symbols-outlined text-4xl text-primary mb-4" style="font-variation-settings: 'wght' 200;">water_drop</span>
					<h4 class="font-title-lg text-lg text-on-surface mb-2 uppercase tracking-wider">Modern Technology</h4>
					<p class="font-body-md text-on-surface-variant font-light">Advanced spa systems for hydrotherapy.</p>
				</div>
				<div class="py-6 md:py-0 px-6">
					<span class="material-symbols-outlined text-4xl text-primary mb-4" style="font-variation-settings: 'wght' 200;">storefront</span>
					<h4 class="font-title-lg text-lg text-on-surface mb-2 uppercase tracking-wider">Madurai's First</h4>
					<p class="font-body-md text-on-surface-variant font-light">The only luxury showroom of its kind in the city.</p>
				</div>
			</div>
		</section>

		<!-- Gallery Teaser -->
		<section class="py-section-gap px-gutter max-w-container-max mx-auto" id="gallery">
			<div class="flex justify-between items-end mb-12">
				<h2 class="font-display-md text-3xl md:text-5xl text-on-surface">The Gallery</h2>
				<a class="font-label-md text-label-md text-primary hover:text-on-surface transition-colors pb-1 border-b border-primary uppercase" href="#">View All</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div class="relative h-[400px] group overflow-hidden bg-surface-container">
					<div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="background-image: url('/images/gallery-bathtub.jpg');"></div>
					<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
						<span class="font-display-md text-2xl text-white translate-y-4 group-hover:translate-y-0 transition-transform duration-500">Bathtubs</span>
					</div>
				</div>
				<div class="relative h-[400px] group overflow-hidden bg-surface-container">
					<div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="background-image: url('/images/gallery-spa.jpg');"></div>
					<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8">
						<span class="font-display-md text-2xl text-white translate-y-4 group-hover:translate-y-0 transition-transform duration-500">Spa Systems</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact & Location -->
		<section class="relative bg-surface-container-low" id="location">
			<div class="grid grid-cols-1 lg:grid-cols-2 min-h-[600px]">
				<!-- Address & Details Column -->
				<div class="flex items-center justify-center p-8 lg:p-24 bg-surface border-y border-outline-variant/30 lg:border-y-0 lg:border-r">
					<div class="max-w-md w-full">
						<h2 class="font-display-md text-3xl md:text-5xl text-on-background mb-8">Visit Us</h2>
						<div class="space-y-8">
							<div>
								<h4 class="font-label-md text-xs text-on-surface-variant mb-2 uppercase tracking-widest">Address</h4>
								<p class="font-body-md text-on-background leading-relaxed">
									1st Floor, Door No. 5/93-B,<br/>
									5th Ward, Melur Main Road,<br/>
									Narasingam 4th Bit,<br/>
									Madurai - 625107
								</p>
							</div>
							<div>
								<h4 class="font-label-md text-xs text-on-surface-variant mb-2 uppercase tracking-widest">Concierge</h4>
								<a class="block font-display-md text-2xl text-on-background hover:text-primary transition-colors" href="tel:+919841747859">
									+91 98417 47859
								</a>
							</div>
							<div>
								<h4 class="font-label-md text-xs text-on-surface-variant mb-2 uppercase tracking-widest">Email</h4>
								<a class="font-body-md text-on-background hover:text-primary transition-colors" href="mailto:reachm2biz@gmail.com">
									reachm2biz@gmail.com
								</a>
							</div>
							<div class="pt-6 border-t border-outline-variant/30">
								<a href="https://maps.google.com/?q=1st+Floor,+Door+No.+5/93-B,+5th+Ward,+Melur+Main+Road,+Narasingam+4th+Bit,+Madurai+-+625107" target="_blank" rel="noopener noreferrer" class="block w-full bg-on-background text-white text-center py-4 font-label-md text-label-md tracking-wider hover:bg-primary transition-colors duration-300 uppercase">
									Get Directions
								</a>
							</div>
						</div>
					</div>
				</div>

				<!-- Map Column -->
				<div class="h-[450px] lg:h-auto min-h-[450px] relative bg-surface-container-highest">
					<iframe 
						title="Havenbath Showroom Map Location"
						src="https://maps.google.com/maps?q=1st%20Floor,%20Door%20No.%205/93-B,%205th%20Ward,%20Melur%20Main%20Road,%20Narasingam%204th%20Bit,%20Madurai%20-%20625107&t=&z=16&ie=UTF8&iwloc=&output=embed" 
						class="absolute inset-0 w-full h-full border-0 grayscale opacity-85 hover:grayscale-0 hover:opacity-100 transition-all duration-500" 
						allowfullscreen="" 
						loading="lazy" 
						referrerpolicy="no-referrer-when-downgrade">
					</iframe>
				</div>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="w-full py-16 bg-surface-container-low border-t border-tertiary-container/20">
		<div class="flex flex-col md:flex-row justify-between items-center px-6 md:px-margin-desktop space-y-8 md:space-y-0 max-w-container-max mx-auto">
			<div class="font-display-md text-xl text-on-surface tracking-widest">
				HAVENBATH
			</div>
			<div class="font-body-md text-sm text-on-surface-variant text-center md:text-left font-light">
				© 2025 Msquare Groups | Havenbath | <a class="hover:text-primary transition-colors duration-200" href="mailto:reachm2biz@gmail.com">reachm2biz@gmail.com</a>
			</div>
			<div class="flex space-x-6">
				<a class="font-label-md text-xs text-on-surface-variant hover:text-primary transition-colors duration-200 uppercase" href="#">Privacy</a>
				<a class="font-label-md text-xs text-on-surface-variant hover:text-primary transition-colors duration-200 uppercase" href="#">Terms</a>
				<a class="font-label-md text-xs text-on-surface-variant hover:text-primary transition-colors duration-200 uppercase" href="#location">Contact</a>
			</div>
		</div>
	</footer>
</Layout>

<script>
	// Toggle mobile menu
	const menuBtn = document.querySelector('button[aria-label="Toggle Menu"]');
	const mobileMenu = document.getElementById('mobile-menu');
	
	if (menuBtn && mobileMenu) {
		menuBtn.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});
		
		// Close mobile menu when clicking link
		const mobileLinks = mobileMenu.querySelectorAll('a');
		mobileLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileMenu.classList.add('hidden');
			});
		});
	}
</script>
